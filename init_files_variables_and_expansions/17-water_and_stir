#!/bin/bash
WATER_DIGITS=(w a t e r); STIR_DIGITS=(s t i r); BEST_DIGITS=(b e s t c h o l); to_dec(){ d=0; for ((i=0;i<${#1};i++)); do c=${1:i:1}; for ((v=0;v<${#2[@]};v++)); do [ "$c" = "${2[v]}" ] && val=$v; done; d=$((d*${#2[@]}+val)); done; echo $d; }; from_dec(){ n=$1 r=""; [ "$n" -eq 0 ] && echo "${2[0]}" && return; while [ $n -gt 0 ]; do rem=$((n%${#2[@]})); r="${2[rem]}$r"; n=$((n/${#2[@]})); done; echo $r; }; from_dec $(( $(to_dec $WATER WATER_DIGITS[@]) + $(to_dec $STIR STIR_DIGITS[@]) )) BEST_DIGITS[@]
